proxy-groups:
  - name: VPN
    type: fallback
    interval: 50
    url: http://www.gstatic.com/generate_204
    proxies:
      - Remnawave
      - Zapas
      - VLESS

  - name: Zapas
    hidden: true
    type: fallback
    interval: 40
    url: http://www.gstatic.com/generate_204
    use:
      - zapasList

  - name: VLESS
    hidden: true
    type: fallback
    interval: 30
    url: http://www.gstatic.com/generate_204
    use:
      - VLESSList

  - name: Remnawave
    type: fallback
    proxies:
      - "🇪🇺 📱 Мобильный | АВТО"
      - "🇩🇪 📱 Мобильный #3"
      - "🇩🇪 📱 Мобильный #4"
