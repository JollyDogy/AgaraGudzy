proxy-groups:
  - name: VPN
    type: fallback
    interval: 90
    url: http://www.gstatic.com/generate_204
    proxies:
#градация от лучшего до худшего варианта использования      
      - Servers
      - WARPServer

#WARPserver
  - name: WARPServer
    type: load-balance
    strategy: round-robin
    hidden: false
    interval: 120
    url: http://www.gstatic.com/generate_204
    icon: https://cdn.jsdelivr.net/gh/JollyDogy/AgaraGudzy/icon/WhiteList.png
    proxies:
      - '🇵🇱 Польша'
      - '🇩🇪 Германия'
      - '🇫🇮 Финляндия'

  - name: '🇵🇱 Польша'
